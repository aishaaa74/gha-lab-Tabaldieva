name: Manual
on: workflow_dispatch
env:
  COURSE: DevOps
jobs:
  greet:
    runs-on: ubuntu-latest
    steps:
      - name: Переменная
        run: echo "Курс: $COURSE"
      - name: Кто запустил
        run: echo "Запустил: ${{ github.action }}"
      - name: Сектрет
        run: echo "Секрет: ${{ secret.MY_SECRET}}"
